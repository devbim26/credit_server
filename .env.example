# Скопируйте в .env и заполните. .env не коммитится (добавьте в .gitignore).

# Bearer-ключ для приёма данных от сниппета (POST /api/usage).
# Пустой = auth выключен (только локальная dev!). Для прод всегда задавайте.
CREDITS_API_KEY=

# Bearer-ключ админки GUI (/admin и /api/rates|stats|records|settings|retry-failed).
# Пустой = админка открыта без пароля (только локальная dev!).
ADMIN_KEY=

# Куда пересылать. Пустой = пересылка выключена.
# Контракт devbim.com: PUT /api/OpenRouterModels/updateSubscription
# Тело: {openRouterWebUiUserId, messageCost, modelId, modelName,
#        requestText, responseText, requestDate, responseDate,
#        isSuccess, errorMessage, metadataJson}
# Боевой URL: https://devbim.com/api/OpenRouterModels/updateSubscription
# ВНИМАНИЕ: devbim.com НЕ требует ключа на этом эндпоинте — идентификация
# пользователя идёт по openRouterWebUiUserId (UUID) в теле запроса.
# FORWARD_API_KEY оставляйте пустым (заголовок Authorization не отправляется).
FORWARD_URL=
FORWARD_API_KEY=

# Базовый URL этого сервера (для логов/ссылок). По умолчанию http://localhost:4010
BASE_URL=http://localhost:4010

# Файл базы данных SQLite.
DB_PATH=credits.db

# Хост/порт uvicorn.
HOST=0.0.0.0
PORT=4010

# --- Дашборд аналитики (/dashboard, пакет analytics/) ---
# Сервер публикуется через туннель => auth включён. Задайте длинный случайный ключ.
ANALYTICS_REQUIRE_AUTH=true
ANALYTICS_API_KEY=
ANALYTICS_APP_TITLE=Аналитика · Сервер списания кредитов
ANALYTICS_DB_PATH=data/analytics.db

# Туннель credits для управления из дашборда (страница «Логи»).
# CLOUDFLARED_BIN задан явно: в C:\Windows\System32 лежит 0-байтовая заглушка.
TUNNEL_NAME=credits
TUNNEL_PUBLIC_HOST=credits.dev-bim.com
CLOUDFLARED_BIN=C:\Program Files (x86)\cloudflared\cloudflared.exe
